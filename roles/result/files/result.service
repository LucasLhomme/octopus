[Unit]
Description=result
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/result
ExecStart=/usr/bin/npm start
Environment="REDIS_HOST={{ redis_host }}"
Environment="REDIS_PORT={{ redis_port }}"
Environment="POSTGRESQL_HOST={{ postgres_host }}"
Environment="POSTGRESQL_PORT={{ postgres_port }}"
Environment="POSTGRESQL_USER={{ postgres_user }}"
Environment="POSTGRESQL_PASSWORD={{ postgres_password }}"
Environment="POSTGRESQL_DB={{ postgres_db }}"
Environment="PORT=80"

[Install]
WantedBy=multi-user.target
